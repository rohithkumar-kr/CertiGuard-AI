# Copy this file to .env and adjust values for your environment.
# SECURITY: never commit the real .env file (it is git-ignored).

# --- Application ---
APP_NAME=CertiGuard AI
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# Backend bind address / port (used by the dev/run entrypoint)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend origin(s) allowed by CORS (comma-separated).
# Wildcard "*" is refused outside development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./certificates.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/certificates

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
UPLOAD_DIR=uploads
# Keep at most this many stored uploads; oldest are pruned first.
UPLOAD_RETENTION_MAX=200
# Bound concurrent verifications (burst protection).
MAX_CONCURRENT_VERIFICATIONS=8

# --- Model ---
# Production model must stay random_forest_v3 (do NOT point at candidates).
MODEL_VERSION=random_forest_v3
MODEL_ARTIFACT_DIR=./models/artifacts
MODEL_METADATA_DIR=./models/metadata
# Decision boundary on the predicted fraud probability. Do NOT change from the
# validated 0.5 unless you re-run the frozen external validation.
DECISION_THRESHOLD=0.5

# --- Clerk authentication (backend verification) ---
# Get these from your Clerk Dashboard (API Keys -> Keys / Publishable key area)
# and from "Customize session tokens". Do NOT commit the secret key.
#
# CLERK_SECRET_KEY is required unless you supply CLERK_JWT_KEY. When only the
# secret key is set, the server fetches the signing keys from the Clerk Backend
# API (cached, rotation-safe). When CLERK_JWT_KEY (the PEM public key from
# "Customize session token -> Verify token with a local key") is set,
# verification is fully networkless.
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
#CLERK_JWT_KEY=
# Issuer URL of your Clerk instance — the **Frontend API URL** shown in the
# Dashboard (API Keys -> "Frontend API URL"), e.g.
# https://YOUR-DOMAIN.clerk.accounts.dev
# This is REQUIRED: the token's `iss` claim must match it exactly.
# IMPORTANT: this is NOT the "JWKS URL" (which appends
# /.well-known/jwks.json to the same base). Key retrieval is handled by the
# SDK against the Backend API (https://api.clerk.com) using CLERK_SECRET_KEY;
# keep the two separate. A pasted JWKS URL is tolerated (the suffix is
# stripped) but the plain Frontend API URL is the correct value.
CLERK_ISSUER=https://YOUR-DOMAIN.clerk.accounts.dev
# Developer diagnostics: log the received token's `iss` claim on issuer
# mismatch (a public URL; the JWT is never logged). Leave off in production.
#CLERK_DEBUG_ISSUER=1
# Authorized parties allowed to mint session tokens for this app. Clerk's
# default azp is your publishable key; after changing it in the Dashboard use
# those origins (comma-separated). Optional but recommended.
#CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
#CLERK_AUDIENCE=
#CLERK_CLOCK_SKEW_MS=5000

# --- Frontend Clerk publishable key (mirror of VITE_CLERK_PUBLISHABLE_KEY) ---
# Used only for documentation/consistency; the key itself lives in the
# frontend .env.

# --- Data / training ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
TRAINING_SEED=42

# --- OCR (Phase 10) ---
# Master switch. When off, extraction never runs OCR and image-heavy documents
# fall back to structural signals + manual review.
OCR_ENABLED=true
# auto = RapidOCR (bundled ONNX) then Tesseract if available.
# rapidocr | pytesseract | none also accepted.
OCR_ENGINE=auto
OCR_LANGUAGES=en
# Render resolution used for OCR (higher = better, slower).
OCR_DPI=200
# Maximum pages rendered for OCR (certificates are short).
OCR_MAX_PAGES=4
# Below this embedded-text length the text layer is treated as insufficient
# and OCR is attempted.
OCR_MIN_TEXT_CHARS=40
# Below this length, even non-empty embedded text triggers OCR when core
# fields are also missing (image-heavy certificates).
OCR_HYBRID_CHARS=150
# Fraction of core identity fields that counts as "good enough" without OCR.
OCR_MIN_COMPLETENESS=0.4