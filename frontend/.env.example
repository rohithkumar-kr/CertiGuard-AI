# Public, build-time frontend configuration only. Never put backend secrets
# (CLERK_SECRET_KEY, DATABASE_URL, ...) in this file or in VITE_* variables.

# API base URL. Leave this EMPTY for both supported setups:
#   - Development: the Vite dev server proxies /api to http://127.0.0.1:8000
#     (see vite.config.ts), so the browser stays on http://localhost:5173.
#   - Docker/production: Nginx serves the SPA and reverse-proxies /api/ to the
#     backend service, so requests stay same-origin (http://localhost:8080).
# Only set an absolute URL for an intentionally cross-origin deployment, e.g.
# https://api.example.com. The backend's CORS_ORIGINS must then allow this
# frontend's exact origin.
VITE_API_BASE_URL=

# Clerk publishable key (starts with pk_test_ or pk_live_).
# Get it from the Clerk Dashboard -> API keys. Safe to expose in the frontend.
# It is passed to the frontend image as a build arg, so the image must be
# rebuilt after changing it.
# The backend needs the matching CLERK_SECRET_KEY / CLERK_ISSUER (see
# backend/.env.example); without it every protected API request is rejected.
VITE_CLERK_PUBLISHABLE_KEY=
