# Base URL of the certificate verification backend.
# This MUST match the port the backend is actually listening on.
# The backend runs on: http://127.0.0.1:8000
# (start it with: cd backend && venv\Scripts\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000)
#
# Keep this as the single source of truth — the API client uses this one URL
# for the upload, the health check, and the verification-detail fetch.
#
# If you leave it empty, the dev server proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), so the browser only ever talks to http://localhost:5173.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Clerk publishable key (starts with pk_test_ or pk_live_).
# Get it from the Clerk Dashboard -> API keys. Safe to expose in the frontend.
# The backend needs the matching CLERK_SECRET_KEY / CLERK_ISSUER (see
# backend/.env.example); without it every API request is rejected with 401.
