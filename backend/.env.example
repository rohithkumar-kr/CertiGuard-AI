# Copy this file to .env and adjust values for your environment.
# SECURITY: never commit the real .env file (it is git-ignored).

# --- Application ---
APP_NAME=AI Certificate Verification System
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# Backend bind address / port (used by the dev/run entrypoint)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend origin(s) allowed by CORS (comma-separated).
# Wildcard "*" is refused outside development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./certificates.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/certificates

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
UPLOAD_DIR=uploads
# Keep at most this many stored uploads; oldest are pruned first.
UPLOAD_RETENTION_MAX=200
# Bound concurrent verifications (burst protection).
MAX_CONCURRENT_VERIFICATIONS=8

# --- Model ---
# Production model must stay random_forest_v3 (do NOT point at candidates).
MODEL_VERSION=random_forest_v3
MODEL_ARTIFACT_DIR=./models/artifacts
MODEL_METADATA_DIR=./models/metadata
# Decision boundary on the predicted fraud probability. Do NOT change from the
# validated 0.5 unless you re-run the frozen external validation.
DECISION_THRESHOLD=0.5

# --- Data / training ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
TRAINING_SEED=42

# --- OCR (Phase 10) ---
# Master switch. When off, extraction never runs OCR and image-heavy documents
# fall back to structural signals + manual review.
OCR_ENABLED=true
# auto = RapidOCR (bundled ONNX) then Tesseract if available.
# rapidocr | pytesseract | none also accepted.
OCR_ENGINE=auto
OCR_LANGUAGES=en
# Render resolution used for OCR (higher = better, slower).
OCR_DPI=200
# Maximum pages rendered for OCR (certificates are short).
OCR_MAX_PAGES=4
# Below this embedded-text length the text layer is treated as insufficient
# and OCR is attempted.
OCR_MIN_TEXT_CHARS=40
# Below this length, even non-empty embedded text triggers OCR when core
# fields are also missing (image-heavy certificates).
OCR_HYBRID_CHARS=150
# Fraction of core identity fields that counts as "good enough" without OCR.
OCR_MIN_COMPLETENESS=0.4